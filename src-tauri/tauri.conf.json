{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyCLIProxyAPI Private",
  "identifier": "com.bchewy.easycliproxyapi.private",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "EasyCLIProxyAPI Private",
        "decorations": true,
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI --autoplay-policy=no-user-gesture-required",
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../core-version.txt": "core-version.txt",
      "../cpa-core/CLIProxyAPI_*": "cpa-core/",
      "../cpa-core/checksums.txt": "cpa-core/checksums.txt"
    }
  }
}
