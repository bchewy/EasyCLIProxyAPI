+func TestPrivateBuildCannotLoadNativePluginsEvenWhenExplicitlyEnabled(t *testing.T) {
+	loader := newTestSymbolLoader()
+	plugin := &testPlugin{
+		registerResult:    validTestPlugin("alpha"),
+		reconfigureResult: validTestPlugin("alpha"),
+	}
+	loader.lookups["alpha"] = newTestSymbolLookup(plugin)
+	host := NewForTest(loader)
+	t.Cleanup(host.ShutdownAll)
+	cfg := &config.Config{Plugins: config.PluginsConfig{
+		Enabled: true,
+		Dir:     makePluginDir(t, "alpha"),
+		Configs: enabledPluginConfigs("alpha"),
+	}}
+	host.ApplyConfig(context.Background(), cfg)
+	host.ApplyConfig(context.Background(), cfg) // Reconfiguration cannot reopen the capability.
+	if loader.openCalls != 0 || host.PluginLoaded("alpha") || host.PluginRegistered("alpha") {
+		t.Fatalf("native plugin load escaped the private policy: open calls=%d", loader.openCalls)
+	}
+	if snapshot := host.Snapshot(); snapshot.enabled || len(snapshot.records) != 0 {
+		t.Fatalf("disabled plugin host reported live capabilities: %+v", snapshot)
+	}
+}
