+		cfg.RemoteManagement.AllowRemote || !cfg.RemoteManagement.DisableControlPanel ||
+		!cfg.RemoteManagement.DisableAutoUpdatePanel || !cfg.DisableClaudeCloakMode ||
+		!reflect.DeepEqual(cfg.Models, config.ModelCatalogs{}) {
+		t.Fatalf("effective configuration escaped private policy: host=%q home=%v plugins=%v discovery=%v remote=%+v cloakDisabled=%v models=%+v",
+			cfg.Host, cfg.Home.Enabled, cfg.Plugins.Enabled, cfg.Discovery.Enabled, cfg.RemoteManagement, cfg.DisableClaudeCloakMode, cfg.Models)
+	}
+}
