diff --git a/internal/managementasset/private_build_test.go b/internal/managementasset/private_build_test.go
new file mode 100644
index 0000000..a0f72e1
--- /dev/null
+++ b/internal/managementasset/private_build_test.go
@@ -0,0 +1,51 @@
+package managementasset
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/privatebuild"
+)
+
+type privateAssetTransport struct{ calls atomic.Int32 }
+
+func (p *privateAssetTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	p.calls.Add(1)
+	return nil, errors.New("unexpected management asset request")
+}
+
+func TestPrivateBuildPanelDownloadsAndFallbackAreDisabled(t *testing.T) {
+	transport := &privateAssetTransport{}
+	client := &http.Client{Transport: transport}
+	previous := http.DefaultTransport
+	http.DefaultTransport = transport
+	t.Cleanup(func() { http.DefaultTransport = previous })
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	dir := t.TempDir()
+	StartAutoUpdater(ctx, filepath.Join(dir, "config.yaml"))
+	if EnsureLatestManagementHTML(ctx, dir, "", "https://github.com/example/panel") {
+		t.Fatal("management HTML installation was allowed")
+	}
+	localPath := filepath.Join(dir, "management.html")
+	if ensureFallbackManagementHTML(ctx, client, localPath) {
+		t.Fatal("fallback management HTML installation was allowed")
+	}
+	if _, _, err := fetchLatestAsset(ctx, client, "https://fixture.invalid/releases"); !errors.Is(err, privatebuild.ErrDisabled) {
