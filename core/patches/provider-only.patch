+		if service.applyDiscoveryConfigContext(context.Background(), cfg) {
+			t.Fatal("discovery became active in the private build")
+		}
+	}
+	if created != 0 || manager.enabled || manager.refresh != nil {
+		t.Fatalf("service created discovery network machinery: advertisers=%d enabled=%v", created, manager.enabled)
+	}
+}
