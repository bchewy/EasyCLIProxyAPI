+remote-management:
+  allow-remote: true
+  disable-control-panel: false
+  disable-auto-update-panel: false
+disable-claude-cloak-mode: false
+models:
+  catalog: https://remote.invalid/models.json
+  codex-catalog: https://remote.invalid/codex.json
+  devin-catalog: https://remote.invalid/devin.json
+openai-compatibility:
+  - name: local-fixture
+    base-url: http://127.0.0.1:12345/v1
+    api-key-entries:
+      - api-key: fixture-only-key
+    models:
+      - name: fixture-model
+`)
+	cfg, err := config.ParseConfigBytes(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertPrivateConfig(t, cfg)
+	if len(cfg.OpenAICompatibility) != 1 || cfg.OpenAICompatibility[0].BaseURL != "http://127.0.0.1:12345/v1" {
+		t.Fatal("provider configuration was lost while disabling auxiliary features")
+	}
+	// Home is populated programmatically after JWT processing, outside YAML parsing.
+	cfg.Home = config.HomeConfig{Enabled: true, Host: "remote.invalid", Port: 6379}
+	cfg.ApplyPrivateBuild()
+	assertPrivateConfig(t, cfg)
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(path, data, 0600); err != nil {
+		t.Fatal(err)
+	}
