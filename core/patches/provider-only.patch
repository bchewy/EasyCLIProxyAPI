new file mode 100644
index 0000000..81a60f9
--- /dev/null
+++ b/internal/registry/private_build_test.go
@@ -0,0 +1,104 @@
+package registry
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"net/http"
+	"slices"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type privateCatalogTransport struct{ calls atomic.Int32 }
+
+func TestPrivateBuildPreservesMigratedTerraModel(t *testing.T) {
+	for _, tier := range []struct {
+		name   string
+		models func() []*ModelInfo
+	}{
+		{"team", GetCodexTeamModels},
+		{"plus", GetCodexPlusModels},
+		{"pro", GetCodexProModels},
+	} {
+		t.Run(tier.name, func(t *testing.T) {
+			var model *ModelInfo
+			for _, candidate := range tier.models() {
+				if candidate.ID == "gpt-6.1-terra" {
+					model = candidate
+					break
+				}
+			}
+			if model == nil {
+				t.Fatal("migrated model is unavailable without a remote catalog")
+			}
+			if model.ContextLength != 500000 || model.MaxCompletionTokens != 128000 {
+				t.Fatal("migrated model token limits changed")
+			}
+			if model.Thinking == nil || !slices.Equal(model.Thinking.Levels, []string{"low", "medium", "high", "xhigh", "max"}) {
+				t.Fatal("migrated model reasoning levels changed")
+			}
+			if !slices.Equal(model.SupportedInputModalities, []string{"text", "image"}) {
+				t.Fatal("migrated model input modalities changed")
+			}
+		})
+	}
+}
+
+func (p *privateCatalogTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	p.calls.Add(1)
+	return nil, errors.New("unexpected catalog network request")
+}
+
+func TestPrivateBuildCatalogRefreshAlwaysUsesEmbeddedData(t *testing.T) {
+	transport := &privateCatalogTransport{}
+	previous := http.DefaultTransport
+	http.DefaultTransport = transport
+	t.Cleanup(func() { http.DefaultTransport = previous })
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	for _, catalog := range []struct {
+		name     string
+		data     []byte
+		validate func([]byte) error
+	}{
+		{"general", embeddedModelsJSON, validateCatalogBytes},
+		{"codex", embeddedCodexClientModelsJSON, ValidateCodexClientModelsJSON},
+		{"devin", embeddedDevinModelsJSON, validateDevinCatalogBytes},
+	} {
+		t.Run(catalog.name, func(t *testing.T) {
+			published := make(chan []byte, 1)
+			updater := &catalogUpdater{
+				fetch:   catalogFetcher(catalog.data, []string{"https://fallback.invalid/catalog.json"}, catalog.validate),
+				publish: func(data []byte) ([]string, error) { published <- data; return nil, nil },
+			}
+			updater.configure(ctx, "https://override.invalid/catalog.json")
+			select {
+			case data := <-published:
+				if !bytes.Equal(data, catalog.data) {
+					t.Fatal("catalog contained an external override")
+				}
+			case <-time.After(2 * time.Second):
+				t.Fatal("embedded catalog was not published")
+			}
+			updater.mu.Lock()
+			generation := updater.generation
+			updater.mu.Unlock()
+			updater.configure(ctx, "https://reload.invalid/catalog.json")
+			updater.mu.Lock()
+			defer updater.mu.Unlock()
+			if updater.source != embeddedCatalogSource || updater.generation != generation {
+				t.Fatal("configuration reload replaced or restarted the embedded catalog")
+			}
+		})
+	}
+	for _, source := range []string{"https://direct.invalid/catalog.json", "http://127.0.0.1:1/catalog.json"} {
+		if _, err := readCatalogSource(ctx, source); err == nil {
+			t.Fatalf("direct remote catalog read accepted %s", source)
+		}
+	}
+	if calls := transport.calls.Load(); calls != 0 {
+		t.Fatalf("catalog operations attempted %d HTTP requests", calls)
+	}
+}
